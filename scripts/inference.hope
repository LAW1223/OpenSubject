[base]
type = ml-easy-job

[resource]
usergroup = hadoop-aipnlp
queue = root.hldy_training_cluster.hadoop-aipnlp.h800_roce

[roles]
workers = 1
worker.memory = 1600010
worker.vcore = 160
worker.gcoresh800-80g = 8
worker.ports = 1
worker.script = source /opt/rh/devtoolset-8/enable; gcc --version; ldd --version; strings /lib64/libc.so.6 | grep GLIBC; source /mnt/dolphinfs/ssd_pool/docker/user/hadoop-hldy-nlp/3A/multimodal/liuyexin/miniconda3/bin/activate; conda activate omnigen2; cd /mnt/dolphinfs/ssd_pool/docker/user/hadoop-nlp-hl02/hadoop-aipnlp/3A/multimodal/liuyexin/workspace/project/omnigen-mt-eval; bash shell/eval-open-gpt-image/opensubject/omnigen/inference.sh 

[user_args]
afo.app.suspend.max = 2
afo.app.suspend = false

[am]
afo.app.am.resource.mb = 4096

[tensorboard]
with.tensor.board = false

[docker]
afo.docker.image.name = registry-offlinebiz.sankuai.com/custom_prod/com.sankuai.data.hadoop.gpu/friday-llm/training_cuda12.4_python3.10_glibc2.31_torch2.6_fluentllm_vllm0.7.3_verl0.5_e60dce83:v1.2.0
afo.use.acceleration.submission = true


[data]
afo.data.prefetch = false

[others]
afo.role.worker.task.attempt.max.retry = 3
afo.xm.notice.receivers.account = liuyexin04
afo.app.env.YARN_CONTAINER_RUNTIME_DOCKER_SHM_SIZE_BYTES = 343597383680
with_requirements = false
afo.docker.rw.volume.paths = /ssd_pool/docker/user/hadoop-hldy-nlp:/mnt/dolphinfs/ssd_pool/docker/user/hadoop-hldy-nlp,/ssd_pool/docker/user/hadoop-nlp-hl02/hadoop-aipnlp:/mnt/dolphinfs/ssd_pool/docker/user/hadoop-nlp-hl02/hadoop-aipnlp,/ssd_pool/docker/user/hadoop-hdp-hldy:/mnt/dolphinfs/ssd_pool/docker/user/hadoop-hdp-hldy,/hdd_pool/docker/user/hadoop-hdp-hldy:/mnt/dolphinfs/hdd_pool/docker/user/hadoop-hdp-hldy
afo.dolphinfs.otherusers = hadoop-mlp-ckpt,hadoop-hldy-nlp,hadoop-aipnlp,hadoop-hdp-hldy,hadoop-basecv-hl,hadoop-imagen-hl,hadoop-hdp,hadoop-nlp-sh02,hadoop-nlp-hl02,hadoop-camera3d,hadoop-vision-data
afo.use.hdfs.fuse = true
afo.use.hdfs.fuse.subpath = user/hadoop-hldy-nlp:/mnt/hdfs/user/hadoop-hldy-nlp,user/hadoop-aipnlp:/mnt/hdfs/user/hadoop-aipnlp
afo.use.hdfs.fuse.readonly = false
afo.use.kms = true
source.system = kinet
appName = [hope/ml-easy-job]opensubject_eval@liuyexin04
afo.app.name = [mlp/Hope]opensubject_eval@liuyexin04
afo.engine.wait_for_job_finished = false
afo.app.yarn.node-attribute.filter.pc.gpu.driver.versions = 535.129.03,535.86.10

[failover]
afo.app.support.engine.failover = true